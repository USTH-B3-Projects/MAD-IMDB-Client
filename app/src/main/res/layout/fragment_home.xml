<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/gutter" android:paddingEnd="@dimen/gutter" android:paddingTop="4dp">
        <TextView style="@style/Text.Display" android:text="@string/app_name" />
        <include layout="@layout/include_search" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/movie_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@null" android:scrollbars="none" android:clipToPadding="false" />
        <include layout="@layout/include_state" />
        <LinearLayout android:id="@+id/loading_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:paddingTop="16dp">
            <TextView style="@style/Text.Heading" android:paddingStart="@dimen/gutter" android:text="@string/top_five" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="328dp" android:layout_marginTop="10dp">
                <View android:layout_width="@dimen/poster_width" android:layout_height="@dimen/poster_height" android:layout_gravity="center_horizontal" android:background="@drawable/placeholder" />
            </FrameLayout>
            <TextView style="@style/Text.Body" android:gravity="center" android:text="@string/loading" />
            <TextView style="@style/Text.Title" android:padding="20dp" android:text="@string/discover" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>