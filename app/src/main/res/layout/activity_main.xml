<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/app_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:fitsSystemWindows="true">
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <FrameLayout android:id="@+id/screen_container" android:layout_width="match_parent" android:layout_height="match_parent" />
        <LinearLayout android:id="@+id/feedback_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="58dp" android:layout_gravity="bottom" android:layout_margin="16dp" android:padding="8dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/feedback" android:visibility="gone">
            <TextView android:id="@+id/feedback_text" style="@style/Text" android:layout_width="0dp" android:layout_weight="1" android:textSize="13sp" android:textColor="@color/ink_dark" />
            <Button android:id="@+id/feedback_undo" android:layout_width="wrap_content" android:layout_height="@dimen/touch" android:minWidth="48dp" android:background="@null" android:text="@string/undo" android:textAllCaps="false" android:textColor="@color/gold" />
            <ImageButton android:id="@+id/feedback_dismiss" android:layout_width="@dimen/touch" android:layout_height="@dimen/touch" android:padding="9dp" android:background="@null" android:src="@drawable/ic_clear" app:tint="@color/ink_dark" android:contentDescription="@string/dismiss" />
        </LinearLayout>
        <FrameLayout android:id="@+id/confirmation" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/scrim" android:visibility="gone" android:clickable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_margin="24dp" android:padding="24dp" android:orientation="vertical" android:background="@drawable/surface">
                <TextView style="@style/Text.Heading" android:text="@string/clear_history_title" />
                <TextView style="@style/Text.Body" android:layout_marginTop="12dp" android:text="@string/clear_history_body" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="24dp">
                    <Button android:id="@+id/confirmation_cancel" style="@style/Action.Secondary" android:layout_width="0dp" android:layout_weight="1" android:text="@string/cancel" android:layout_marginEnd="12dp" />
                    <Button android:id="@+id/confirmation_clear" style="@style/Action" android:layout_width="0dp" android:layout_weight="1" android:text="@string/clear" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
    <LinearLayout android:id="@+id/bottom_navigation" android:layout_width="match_parent" android:layout_height="@dimen/nav_height" android:orientation="horizontal" android:baselineAligned="false" android:background="@drawable/nav">
        <LinearLayout android:id="@+id/nav_home" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:contentDescription="@string/home">
            <ImageView android:id="@+id/nav_icon_home" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_home" android:contentDescription="@null" />
            <TextView android:id="@+id/nav_label_home" style="@style/Text.Caption" android:layout_marginTop="4dp" android:gravity="center" android:text="@string/home" />
        </LinearLayout>
        <LinearLayout android:id="@+id/nav_search" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:contentDescription="@string/search">
            <ImageView android:id="@+id/nav_icon_search" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_search" android:contentDescription="@null" />
            <TextView android:id="@+id/nav_label_search" style="@style/Text.Caption" android:layout_marginTop="4dp" android:gravity="center" android:text="@string/search" />
        </LinearLayout>
        <LinearLayout android:id="@+id/nav_favorites" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:contentDescription="@string/favorites">
            <ImageView android:id="@+id/nav_icon_favorites" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_heart" android:contentDescription="@null" />
            <TextView android:id="@+id/nav_label_favorites" style="@style/Text.Caption" android:layout_marginTop="4dp" android:gravity="center" android:text="@string/favorites" />
        </LinearLayout>
        <LinearLayout android:id="@+id/nav_settings" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:contentDescription="@string/settings">
            <ImageView android:id="@+id/nav_icon_settings" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_settings" android:contentDescription="@null" />
            <TextView android:id="@+id/nav_label_settings" style="@style/Text.Caption" android:layout_marginTop="4dp" android:gravity="center" android:text="@string/settings" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
