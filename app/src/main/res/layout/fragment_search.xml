<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/gutter" android:paddingEnd="@dimen/gutter" android:paddingTop="4dp">
        <TextView style="@style/Text.Display" android:text="@string/search" />
        <include android:id="@+id/search_field" layout="@layout/include_search" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="22dp" />
        <TextView android:id="@+id/results_heading" style="@style/Text.Title" android:layout_marginTop="26dp" android:layout_marginBottom="12dp" android:text="@string/results" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/movie_list" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="@dimen/gutter" android:paddingEnd="@dimen/gutter" android:divider="@null" android:scrollbars="none" />
        <ListView android:id="@+id/suggestion_list" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="@dimen/gutter" android:paddingEnd="@dimen/gutter" android:divider="?attr/movieBackground" android:dividerHeight="12dp" android:visibility="gone" />
        <include layout="@layout/include_state" />
        <include layout="@layout/include_loading" />
    </FrameLayout>
</LinearLayout>