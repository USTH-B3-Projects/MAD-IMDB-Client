<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:paddingTop="4dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical">
            <ImageButton android:id="@+id/about_back" style="@style/IconAction" android:background="@null" android:src="@drawable/ic_back" app:tint="?attr/movieText" android:contentDescription="@string/back" />
            <TextView style="@style/Text.Heading" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/about" />
        </LinearLayout>
        <View android:layout_width="40dp" android:layout_height="5dp" android:layout_marginTop="28dp" android:background="@drawable/gold_shape" />
        <TextView style="@style/Text.Display" android:layout_marginTop="12dp" android:text="@string/imdb_client" />
        <TextView style="@style/Text.Body" android:layout_marginTop="12dp" android:text="@string/about_description" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp" android:background="@drawable/surface" android:paddingStart="16dp" android:paddingEnd="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="16dp" android:paddingBottom="16dp" android:orientation="horizontal">
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="10dp" android:background="@drawable/chip" android:src="@drawable/ic_home_idle" app:tint="?attr/movieText" android:contentDescription="@null" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:orientation="vertical">
                    <TextView style="@style/Text" android:textStyle="bold" android:text="@string/discover_feature" />
                    <TextView style="@style/Text.Body" android:layout_marginTop="4dp" android:text="@string/discover_feature_body" />
                </LinearLayout>
            </LinearLayout>
            <View style="@style/Divider" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="16dp" android:paddingBottom="16dp" android:orientation="horizontal">
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="10dp" android:background="@drawable/chip" android:src="@drawable/ic_search" app:tint="?attr/movieText" android:contentDescription="@null" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:orientation="vertical">
                    <TextView style="@style/Text" android:textStyle="bold" android:text="@string/search_feature" />
                    <TextView style="@style/Text.Body" android:layout_marginTop="4dp" android:text="@string/search_feature_body" />
                </LinearLayout>
            </LinearLayout>
            <View style="@style/Divider" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="16dp" android:paddingBottom="16dp" android:orientation="horizontal">
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="10dp" android:background="@drawable/chip" android:src="@drawable/ic_heart" app:tint="?attr/movieText" android:contentDescription="@null" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:orientation="vertical">
                    <TextView style="@style/Text" android:textStyle="bold" android:text="@string/favorites_feature" />
                    <TextView style="@style/Text.Body" android:layout_marginTop="4dp" android:text="@string/favorites_feature_body" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <TextView style="@style/Text.Title" android:layout_marginTop="24dp" android:text="@string/data_heading" />
        <TextView style="@style/Text" android:layout_marginTop="10dp" android:text="@string/data_provider" />
        <TextView style="@style/Text.Body" android:layout_marginTop="10dp" android:text="@string/attribution" />
        <TextView android:id="@+id/app_version" style="@style/Text.Caption" android:layout_marginTop="20dp" android:layout_marginBottom="24dp" />
    </LinearLayout>
</ScrollView>