<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/gutter" android:paddingEnd="@dimen/gutter" android:paddingTop="4dp">
        <TextView android:id="@+id/favorites_heading" style="@style/Text.Display" android:text="@string/favorites" />
        <TextView android:id="@+id/saved_count" style="@style/Text.Body" android:layout_marginTop="2dp" />
        <LinearLayout android:id="@+id/favorite_tools" android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginTop="16dp" android:gravity="center_vertical" android:orientation="horizontal">
            <Button android:id="@+id/add_film" style="@style/Action" android:layout_width="0dp" android:layout_weight="1" android:text="@string/add_film" />
            <LinearLayout android:layout_width="52dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:layout_marginStart="8dp">
                <ImageButton android:id="@+id/sort_films" style="@style/IconAction" android:padding="9dp" android:src="@drawable/ic_sort" app:tint="?attr/movieText" android:contentDescription="@string/sort" />
                <TextView style="@style/Text.Caption" android:layout_marginTop="3dp" android:gravity="center" android:text="@string/sort" />
            </LinearLayout>
            <LinearLayout android:layout_width="52dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:layout_marginStart="8dp">
                <ImageButton android:id="@+id/select_films" style="@style/IconAction" android:padding="9dp" android:src="@drawable/ic_check" app:tint="?attr/movieText" android:contentDescription="@string/select" />
                <TextView style="@style/Text.Caption" android:layout_marginTop="3dp" android:gravity="center" android:text="@string/select" />
            </LinearLayout>
        </LinearLayout>
        <View android:id="@+id/favorites_divider" style="@style/Divider" android:layout_marginTop="8dp" android:layout_marginBottom="18dp" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/movie_list" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="16dp" android:paddingEnd="16dp" android:divider="@null" android:scrollbars="none" />
        <include layout="@layout/include_state" />
        <TextView android:id="@+id/favorites_loading" style="@style/Text.Body" android:text="@string/loading" android:gravity="center" android:layout_gravity="center" />
    </FrameLayout>
    <LinearLayout android:id="@+id/selection_tools" android:layout_width="match_parent" android:layout_height="72dp" android:paddingStart="20dp" android:paddingEnd="20dp" android:background="@drawable/nav" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <Button android:id="@+id/remove_selected" style="@style/Action.Danger" android:layout_width="0dp" android:layout_weight="1" android:text="@string/remove" />
        <Button android:id="@+id/cancel_selection" style="@style/Action.Secondary" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/cancel" />
    </LinearLayout>
</LinearLayout>
